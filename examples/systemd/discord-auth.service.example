# Replace EVERY /opt/bedrock-discord-auth with the unpacked repository's absolute path.
# This is a user unit: install to ~/.config/systemd/user/discord-auth.service.
[Unit]
Description=Bedrock Discord role admission API and bot
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/bedrock-discord-auth/discord-auth
ExecStart=/opt/bedrock-discord-auth/discord-auth/venv/bin/python /opt/bedrock-discord-auth/discord-auth/service.py
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
